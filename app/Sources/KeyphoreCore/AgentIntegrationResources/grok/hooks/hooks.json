    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "\"${GROK_PLUGIN_ROOT}/bin/keyphore\" hook grok", "timeout": 1 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"${GROK_PLUGIN_ROOT}/bin/keyphore\" hook grok", "timeout": 1 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "\"${GROK_PLUGIN_ROOT}/bin/keyphore\" hook grok", "timeout": 1 }] }],
