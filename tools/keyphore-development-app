#!/bin/zsh
set -eu
set -o pipefail

repository_root=${0:A:h:h}
applications_directory="$HOME/Applications"
destination="$applications_directory/Keyphore.app"
legacy_destination="$applications_directory/Keyphore Development.app"
launchctl_bin=${KEYPHORE_LAUNCHCTL_BIN:-/bin/launchctl}
open_bin=${KEYPHORE_OPEN_BIN:-/usr/bin/open}
launch_domain="gui/$(/usr/bin/id -u)"
current_target="$launch_domain/com.barrywu.keyphore.companion"
legacy_target="$launch_domain/com.barrybarrywu.keyphore"
development_team=${KEYPHORE_DEVELOPMENT_TEAM:-RFW398ARA9}
signing_identity=${KEYPHORE_SIGNING_IDENTITY:-Developer ID Application}
redirect_system_app=${KEYPHORE_REDIRECT_SYSTEM_APP:-0}
system_destination=/Applications/Keyphore.app

usage() {
  print 'Usage: tools/keyphore-development-app build-open | install <Keyphore.app> | verify <Keyphore.app> | preflight'
  print 'Local signing: set KEYPHORE_DEVELOPMENT_TEAM and KEYPHORE_SIGNING_IDENTITY to the team and full Apple Development certificate name.'
  print 'Set KEYPHORE_REDIRECT_SYSTEM_APP=1 to back up the matching system App and point its old path at the user App.'
}

service_is_loaded() {
  "$launchctl_bin" print "$1" >/dev/null 2>&1
}

preflight() {
  # Quit every installed location through the App so signal-off can complete.
  if /usr/bin/pgrep -f '/Keyphore[^/]*/Contents/MacOS/Keyphore$' >/dev/null; then
    /usr/bin/osascript -l JavaScript -e '
      ObjC.import("AppKit");
      const apps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier("com.barrywu.keyphore");
      for (let index = 0; index < apps.count; index++) {
        const app = apps.objectAtIndex(index);
        app.terminate;
      }
    ' >/dev/null 2>&1 || true
  fi
  for _ in {1..100}; do
    if ! /usr/bin/pgrep -f '/Keyphore[^/]*/Contents/MacOS/Keyphore$' >/dev/null; then
      break
    fi
    /bin/sleep 0.1
  done
  if /usr/bin/pgrep -f '/Keyphore[^/]*/Contents/MacOS/Keyphore$' >/dev/null; then
    print -u2 'A Keyphore App is still running after safe quit; refusing to replace it or stop its Companion.'
    return 1
  fi

  "$launchctl_bin" bootout "$current_target" >/dev/null 2>&1 || true
  "$launchctl_bin" bootout "$legacy_target" >/dev/null 2>&1 || true
  if service_is_loaded "$current_target" || service_is_loaded "$legacy_target"; then
    print -u2 'A Keyphore Companion is still registered; refusing a second HID owner.'
    return 1
  fi
  if /usr/bin/pgrep -f '/(keyphore|Keyphore Companion) companion($| )' >/dev/null; then
    print -u2 'An unregistered Keyphore Companion is still running; stop it before continuing.'
    return 1
  fi
}

verify_app() {
  local source_app=$1
  local companion_app="$source_app/Contents/Library/LoginItems/Keyphore Companion.app"
  local companion_executable="$companion_app/Contents/MacOS/Keyphore Companion"
  if [[ ! -d "$source_app" || ! -x "$source_app/Contents/Helpers/keyphore" ]]; then
    print -u2 'The build does not contain an executable Keyphore helper.'
    return 1
  fi
  if [[ ! -x "$companion_executable" || ! -f "$companion_app/Contents/Resources/AppIcon.icns" ]]; then
    print -u2 'The build does not contain the branded Keyphore Companion App.'
    return 1
  fi
  local bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$source_app/Contents/Info.plist")
  local companion_bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$companion_app/Contents/Info.plist")
  local companion_display_name=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$companion_app/Contents/Info.plist")
  local companion_icon=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$companion_app/Contents/Info.plist")
  if [[ "$bundle_id" != 'com.barrywu.keyphore' || "$companion_bundle_id" != 'com.barrywu.keyphore.companion' ]]; then
    print -u2 'The build has an unexpected bundle identifier.'
    return 1
  fi
  if [[ "$companion_display_name" != 'Keyphore' || "$companion_icon" != 'AppIcon' ]]; then
    print -u2 'The Companion App does not carry the Keyphore name and icon.'
    return 1
  fi
  case "$signing_identity" in
    'Developer ID Application'|Developer\ ID\ Application:*|Apple\ Development:*) ;;
    *)
      print -u2 'Use a Developer ID Application or full Apple Development certificate name; unsigned and ad-hoc builds are not accepted.'
      return 1
      ;;
  esac
  local signed_path details team authority app_authority=''
  for signed_path in "$source_app" "$source_app/Contents/Helpers/keyphore" "$companion_app"; do
    /usr/bin/codesign --verify --strict "$signed_path" || return 1
    details=$(/usr/bin/codesign -dv --verbose=4 "$signed_path" 2>&1) || return 1
    team=$(print -r -- "$details" | /usr/bin/awk -F= '/^TeamIdentifier=/{print $2}')
    authority=$(print -r -- "$details" | /usr/bin/awk -F= '/^Authority=/{if (!found++) print $2}')
    if [[ "$team" != "$development_team" ]]; then
      print -u2 'The development App, helper and Companion must use the configured development team signature.'
      return 1
    fi
    if [[ "$signing_identity" == 'Developer ID Application' ]]; then
      [[ "$authority" == Developer\ ID\ Application:* ]] || {
        print -u2 'The development App requires a Developer ID identity unless a full local identity is explicitly configured.'
        return 1
      }
    elif [[ "$authority" != "$signing_identity" ]]; then
      print -u2 'The development App signature does not match KEYPHORE_SIGNING_IDENTITY.'
      return 1
    fi
    if [[ -n "$app_authority" && "$authority" != "$app_authority" ]]; then
      print -u2 'The App, helper and Companion must use the same signing identity.'
      return 1
    fi
    app_authority=$authority
  done
  /usr/bin/codesign --verify --deep --strict "$source_app"
}

install_app() {
  local source_app=$1
  verify_app "$source_app" || return 1

  /bin/mkdir -p "$applications_directory"
  local canonical_applications_directory
  canonical_applications_directory=$(cd "$applications_directory" && /bin/pwd -P) || return 1
  case "$canonical_applications_directory" in
    /Users/*/Applications) ;;
    *)
      print -u2 'Refusing a development App destination outside a user Applications directory.'
      return 1
      ;;
  esac
  destination="$canonical_applications_directory/Keyphore.app"
  legacy_destination="$canonical_applications_directory/Keyphore Development.app"
  local redirect_needed=0
  case "$redirect_system_app" in
    0) ;;
    1)
      if [[ -L "$system_destination" ]]; then
        if [[ "$(/usr/bin/readlink "$system_destination")" != "$destination" ]]; then
          print -u2 'Refusing to replace an unexpected system App symlink.'
          return 1
        fi
      else
        if [[ ! -w "${system_destination:h}" ]]; then
          print -u2 'The system Applications directory is not writable; no Apps were replaced.'
          return 1
        fi
        if [[ -e "$system_destination" ]]; then
          verify_app "$system_destination" || return 1
        fi
        redirect_needed=1
      fi
      ;;
    *) print -u2 'KEYPHORE_REDIRECT_SYSTEM_APP must be 0 or 1.'; return 1 ;;
  esac
  local staging_root
  staging_root=$(/usr/bin/mktemp -d "$canonical_applications_directory/.Keyphore.XXXXXX") || return 1
  local staging="$staging_root/Keyphore.app" previous=''
  # The staged copy is verified before the running App is asked to quit.
  if ! /usr/bin/ditto "$source_app" "$staging" || ! verify_app "$staging" || ! preflight; then
    /bin/rm -rf "$staging_root"
    return 1
  fi
  /bin/mkdir -p "$HOME/.Trash"
  previous=$(/usr/bin/mktemp -d "$HOME/.Trash/Keyphore.previous.XXXXXX")
  print -u2 "Previous App backup: $previous"
  local installed=0
  if { [[ ! -e "$destination" ]] || /bin/mv "$destination" "$previous/Keyphore.app"; } &&
     { [[ ! -e "$legacy_destination" ]] || /bin/mv "$legacy_destination" "$previous/Keyphore Development.app"; } &&
     { [[ "$redirect_needed" != 1 || ! -e "$system_destination" ]] || /bin/mv "$system_destination" "$previous/Keyphore.system.app"; } &&
     { /bin/mv "$staging" "$destination" && installed=1; } &&
     { [[ "$redirect_needed" != 1 ]] || /bin/ln -s "$destination" "$system_destination"; }; then
    if [[ "$redirect_system_app" == 1 ]]; then
      print -u2 "System App entry points to: $destination"
    fi
  else
    # All Apps have quit. Restore only the paths moved by this installation.
    [[ "$installed" != 1 ]] || /bin/rm -rf "$destination"
    [[ ! -e "$previous/Keyphore.app" ]] || /bin/mv "$previous/Keyphore.app" "$destination"
    [[ ! -e "$previous/Keyphore Development.app" ]] || /bin/mv "$previous/Keyphore Development.app" "$legacy_destination"
    [[ ! -e "$previous/Keyphore.system.app" ]] || /bin/mv "$previous/Keyphore.system.app" "$system_destination"
    /bin/rm -rf "$staging_root"
    print -u2 "Installation failed; previous Apps restored. Backup directory: $previous"
    return 1
  fi
  /bin/rmdir "$staging_root"
  "$open_bin" "$destination"
  print "$destination"
}

build_open() {
  /bin/mkdir -p /private/tmp/codex-builds
  build_root=$(/usr/bin/mktemp -d /private/tmp/codex-builds/keyphore-development.XXXXXX)
  trap '/bin/rm -rf "$build_root"' EXIT
  /usr/bin/xcodebuild \
    -project "$repository_root/Keyphore.xcodeproj" \
    -scheme Keyphore \
    -configuration Debug \
    -derivedDataPath "$build_root/DerivedData" \
    DEVELOPMENT_TEAM="$development_team" \
    CODE_SIGN_STYLE=Manual \
    CODE_SIGN_IDENTITY="$signing_identity" \
    CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
    build
  install_app "$build_root/DerivedData/Build/Products/Debug/Keyphore.app"
}

case ${1:-} in
  build-open)
    [[ $# -eq 1 ]] || { usage; exit 64; }
    build_open
    ;;
  install)
    [[ $# -eq 2 ]] || { usage; exit 64; }
    install_app "$2"
    ;;
  verify)
    [[ $# -eq 2 ]] || { usage; exit 64; }
    verify_app "$2"
    ;;
  preflight)
    [[ $# -eq 1 ]] || { usage; exit 64; }
    preflight
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage
    exit 64
    ;;
esac
